{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auditgym.local/schemas/provenance.schema.json",
  "title": "provenance.json (private, grader only)",
  "description": "Generation history: config, seed, sampled counts, causal changes per issue. schema_version 1.0.",
  "schema_version": "1.0",
  "type": "object",
  "required": [
    "schema_version",
    "episode_id",
    "generator_version",
    "config_version",
    "config",
    "seed",
    "changes"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "episode_id": {
      "type": "string"
    },
    "generator_version": {
      "type": "string"
    },
    "config_version": {
      "type": "string"
    },
    "config": {
      "type": "object"
    },
    "seed": {
      "type": "integer"
    },
    "attempt": {
      "type": "integer",
      "minimum": 0
    },
    "sampled": {
      "type": "object"
    },
    "company": {
      "type": "object"
    },
    "pre_injection": {
      "type": "object"
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "issue_ids",
          "target",
          "field",
          "before",
          "after"
        ],
        "properties": {
          "issue_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "target": {
            "type": "string"
          },
          "field": {
            "type": "string"
          },
          "before": {},
          "after": {},
          "note": {
            "type": "string"
          }
        }
      }
    },
    "ledger_diff": {
      "type": "object"
    },
    "distractors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "ids"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
