{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auditgym.local/schemas/trajectory_line.schema.json",
  "title": "One line of trajectories.jsonl",
  "description": "Written by the runner after every step. Must never contain truth/provenance/seed. schema_version 1.0.",
  "schema_version": "1.0",
  "type": "object",
  "required": [
    "episode_id",
    "step",
    "action",
    "observation",
    "reward",
    "terminated",
    "truncated",
    "policy",
    "env_version"
  ],
  "properties": {
    "episode_id": {
      "type": "string"
    },
    "step": {
      "type": "integer",
      "minimum": 0
    },
    "action": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "action.schema.json"
        }
      ],
      "description": "null for the reset line (step 0)"
    },
    "observation": {
      "type": "object"
    },
    "reward": {
      "type": "number",
      "minimum": -1,
      "maximum": 1
    },
    "terminated": {
      "type": "boolean"
    },
    "truncated": {
      "type": "boolean"
    },
    "policy": {
      "type": "string"
    },
    "env_version": {
      "type": "string"
    },
    "config_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "mode": {
      "enum": [
        "train",
        "eval"
      ]
    }
  },
  "not": {
    "anyOf": [
      {
        "required": [
          "seed"
        ]
      },
      {
        "required": [
          "truth"
        ]
      },
      {
        "required": [
          "provenance"
        ]
      },
      {
        "required": [
          "issue_id"
        ]
      },
      {
        "required": [
          "expected_amount_minor"
        ]
      },
      {
        "required": [
          "evidence_sets"
        ]
      }
    ]
  }
}
