{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auditgym.local/schemas/config.schema.json",
  "title": "Generator config (configs/presets/*.json)",
  "description": "Partial configs are merged with generator defaults; validated again by auditgym.generator.config. schema_version 1.0.",
  "schema_version": "1.0",
  "type": "object",
  "required": [
    "config_version"
  ],
  "additionalProperties": false,
  "properties": {
    "config_version": {
      "const": "1.0"
    },
    "name": {
      "type": "string"
    },
    "n_ledger_rows": {
      "type": "integer",
      "minimum": 200,
      "maximum": 2000
    },
    "n_documents": {
      "type": "integer",
      "minimum": 20,
      "maximum": 200
    },
    "base_currency": {
      "oneOf": [
        {
          "enum": [
            "KZT",
            "USD",
            "EUR",
            "JPY"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "currencies": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "KZT",
          "USD",
          "EUR",
          "JPY"
        ]
      }
    },
    "n_foreign_currencies": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "array",
          "prefixItems": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "integer",
              "minimum": 0
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        }
      ],
      "description": "int or inclusive range [lo, hi], sampled per seed"
    },
    "foreign_invoice_share": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "timezone": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[+-]\\d{2}:\\d{2}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "period": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
        },
        {
          "type": "null"
        }
      ]
    },
    "clean": {
      "type": "boolean"
    },
    "error_counts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "duplicate_invoice": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "array",
              "prefixItems": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "integer",
                  "minimum": 0
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            }
          ],
          "description": "int or inclusive range [lo, hi], sampled per seed"
        },
        "payment_allocation": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "array",
              "prefixItems": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "integer",
                  "minimum": 0
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            }
          ],
          "description": "int or inclusive range [lo, hi], sampled per seed"
        },
        "fx_conversion": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "array",
              "prefixItems": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "integer",
                  "minimum": 0
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            }
          ],
          "description": "int or inclusive range [lo, hi], sampled per seed"
        },
        "period_cutoff": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "array",
              "prefixItems": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "integer",
                  "minimum": 0
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            }
          ],
          "description": "int or inclusive range [lo, hi], sampled per seed"
        }
      }
    },
    "interactions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "A": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "array",
              "prefixItems": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "integer",
                  "minimum": 0
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            }
          ],
          "description": "int or inclusive range [lo, hi], sampled per seed"
        },
        "B": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "array",
              "prefixItems": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "integer",
                  "minimum": 0
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            }
          ],
          "description": "int or inclusive range [lo, hi], sampled per seed"
        }
      }
    },
    "distractors": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "split_payment": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "array",
              "prefixItems": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "integer",
                  "minimum": 0
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            }
          ],
          "description": "int or inclusive range [lo, hi], sampled per seed"
        },
        "partial_payment": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "array",
              "prefixItems": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "integer",
                  "minimum": 0
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            }
          ],
          "description": "int or inclusive range [lo, hi], sampled per seed"
        },
        "recurring": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "array",
              "prefixItems": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "integer",
                  "minimum": 0
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            }
          ],
          "description": "int or inclusive range [lo, hi], sampled per seed"
        },
        "refund": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "array",
              "prefixItems": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "integer",
                  "minimum": 0
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            }
          ],
          "description": "int or inclusive range [lo, hi], sampled per seed"
        },
        "boundary": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "array",
              "prefixItems": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "integer",
                  "minimum": 0
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            }
          ],
          "description": "int or inclusive range [lo, hi], sampled per seed"
        },
        "next_period_invoice": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "array",
              "prefixItems": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "integer",
                  "minimum": 0
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            }
          ],
          "description": "int or inclusive range [lo, hi], sampled per seed"
        },
        "weekend_fx": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "array",
              "prefixItems": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "integer",
                  "minimum": 0
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            }
          ],
          "description": "int or inclusive range [lo, hi], sampled per seed"
        },
        "prior_invoice": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "array",
              "prefixItems": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "integer",
                  "minimum": 0
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            }
          ],
          "description": "int or inclusive range [lo, hi], sampled per seed"
        }
      }
    }
  }
}
