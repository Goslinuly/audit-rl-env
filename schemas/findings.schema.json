{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auditgym.local/schemas/findings.schema.json",
  "title": "findings.json (argument of submit)",
  "description": "Agent answer. Any violation => reward -1. Also checked by the grader: episode_id equals the episode. The top level is strict; unknown keys inside a finding are ignored. A well-formed currency code not used in the episode is valid but never matches (false positive). Grader 1.1.0, schema_version 1.0.",
  "schema_version": "1.0",
  "type": "object",
  "required": [
    "episode_id",
    "findings"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "episode_id": {
      "type": "string"
    },
    "findings": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "$ref": "#/$defs/finding"
      }
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": true,
      "description": "Unknown extra keys (e.g. confidence) are allowed and ignored by the grader.",
      "required": [
        "type",
        "affected_ids",
        "claimed_amount_minor",
        "currency",
        "evidence_ids"
      ],
      "properties": {
        "type": {
          "enum": [
            "duplicate_invoice",
            "payment_allocation",
            "fx_conversion",
            "period_cutoff"
          ]
        },
        "affected_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "\\S"
          }
        },
        "claimed_amount_minor": {
          "type": "integer",
          "minimum": -1000000000000000000,
          "maximum": 1000000000000000000,
          "description": "integer minor units. JSON Schema 2020-12 treats 100.0 as an integer; the grader (auditgym.grader.validate) is stricter and rejects any float, even 100.0"
        },
        "currency": {
          "type": "string",
          "pattern": "^\\s*[A-Za-z]{3}\\s*$"
        },
        "evidence_ids": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "\\S"
          }
        },
        "explanation": {
          "type": "string",
          "maxLength": 1000,
          "description": "short justification; never read by the grader"
        }
      }
    }
  }
}
